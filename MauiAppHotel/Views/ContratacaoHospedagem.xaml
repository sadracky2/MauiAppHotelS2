<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem">
    <VerticalStackLayout Padding="10"
                         BackgroundColor="#D9BE9B">
        <Label Text="Cálculo da Diária"
               FontSize="40"
               FontFamily="ComicSans"
               TextColor="#1F2022"
               Margin="0, 150, 0, 30"/>
        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="BurlyWood">
            <VerticalStackLayout Padding="10">
                <Grid ColumnDefinitions="*,*,*"
                      RowDefinitions="Auto, Auto">

                    <Label Grid.Row="0" Grid.Column="0" 
                           Text="Adultos:" 
                           TextColor="#1F2022"/>
                    
                    <Label Grid.Row="0" Grid.Column="1" 
                           Text="{Binding Value}" 
                           BindingContext="{x:Reference StepperAdultos}"
                           TextColor="#1F2022"/>

                    <Stepper x:Name="StepperAdultos" Grid.Row="0" Grid.Column="2" Minimum="1" Maximum="7"/>

                    <Label Grid.Row="1" Grid.Column="0" 
                           Text="Crianças" 
                           TextColor="#1F2022"/>
                    
                    <Label Grid.Row="1" Grid.Column="1" 
                           Text="{Binding Value}" 
                           BindingContext="{x:Reference StepperCriancas}" 
                           TextColor="#1F2022"/>
                    
                    <Stepper x:Name="StepperCriancas" Grid.Row="1" Grid.Column="2" Minimum="1" Maximum="5"/>

                </Grid>
                
                <Label Text="Selecione sua Acomodação:"
                       TextColor="#1F2022"
                       HorizontalTextAlignment="Center"
                       Margin="0, 20, 0, 5"/>
                <Picker x:Name="PickerQuarto" />
                
                
                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor="#A6967B">

                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *">

                        <Label Grid.Row="0" 
                               Grid.Column="0" 
                               Text="Data Check-in:" 
                               TextColor="#1F2022"
                               Margin="5, 10, 0, 0"/>
                        <DatePicker x:Name="DataCheckin" Grid.Row="0" Grid.Column="1"/>

                        <Label Grid.Row="1" 
                               Grid.Column="0" 
                               Text="Data Check-out:" 
                               TextColor="#1F2022"
                               Margin="5, 10, 0, 0"/>
                        <DatePicker x:Name="DataCheckout" Grid.Row="1" Grid.Column="1"/>

                    </Grid>
                </Border>

                <Button Clicked="Button_Clicked" Text="Sobre" TextColor="#1F2022"/>

            </VerticalStackLayout>
    </Border>
    </VerticalStackLayout>
</ContentPage>